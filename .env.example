# Second Sight Environment Variables
# Copy this file to .env and fill in real values

# Server Configuration
PORT=3000
NODE_ENV=development

# PayPal Sandbox Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_secret
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/secondsight?retryWrites=true&w=majority

# AI Provider API Key (Grok xAI or Gemini)
XAI_API_KEY=your_xai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Hold Configuration (minutes until automatic void)
# 1440 = 24 hours (standard); use 2 for fast demo testing
HOLD_MINUTES=1440
